SERVER_HOST=0.0.0.0
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/qvorum
DB_USER=qvorum
DB_PASSWORD=qvorum

# At least 32 characters.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# SMTP server for emails. The defaults match Mailpit in docker-compose.yml (web UI: http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Qvorum <no-reply@qvorum.test>

# Folder for uploaded photos.
UPLOAD_DIR=uploads
